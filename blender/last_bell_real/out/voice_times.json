[
 {
  "line": 1,
  "start": 0.3,
  "end": 2.9549999999999996,
  "who": null,
  "text": "اون روز صبح... نباید می‌رفتم."
 },
 {
  "line": 2,
  "start": 4.5,
  "end": 6.0555208333333335,
  "who": "Anchor",
  "text": "...گزارش‌ها حاکی است..."
 },
 {
  "line": 3,
  "start": 6.115520833333333,
  "end": 7.935874999999999,
  "who": "Anchor",
  "text": "ارتش دچار نابسامانی شده..."
 },
 {
  "line": 4,
  "start": 8.0,
  "end": 9.045291666666667,
  "who": "Mom",
  "text": "صبحونه نخوردی!"
 },
 {
  "line": 5,
  "start": 9.105291666666668,
  "end": 10.648791666666668,
  "who": "Me",
  "text": "دیرم شده. خداحافظ!"
 },
 {
  "line": 6,
  "start": 10.708791666666668,
  "end": 12.438791666666669,
  "who": "Mom",
  "text": "زود برگردی خونه‌ها!"
 },
 {
  "line": 8,
  "start": 15.5,
  "end": 17.240791666666667,
  "who": "Kazemi",
  "text": "ساکت! صفحهٔ چهل‌ودو."
 },
 {
  "line": 9,
  "start": 17.300791666666665,
  "end": 18.745874999999998,
  "who": "Arian",
  "text": "بازم امتحان داریم؟"
 },
 {
  "line": 10,
  "start": 18.805874999999997,
  "end": 20.785874999999997,
  "who": "Kazemi",
  "text": "آرین! حواست کجاست؟"
 },
 {
  "line": 11,
  "start": 22.6,
  "end": 24.105375000000002,
  "who": "Mom voice",
  "text": "داره اتفاقایی میفته..."
 },
 {
  "line": 12,
  "start": 24.165375,
  "end": 25.880354166666667,
  "who": "Mom voice",
  "text": "مواظب خودت باش..."
 },
 {
  "line": 13,
  "start": 28.3,
  "end": 29.746458333333333,
  "who": "Me",
  "text": "مامانم باز شلوغش کرده."
 },
 {
  "line": 14,
  "start": 29.80645833333333,
  "end": 31.356458333333332,
  "who": "Arian",
  "text": "لابد اخبار دیده!"
 },
 {
  "line": 15,
  "start": 31.5,
  "end": 32.81997916666667,
  "who": "Kazemi",
  "text": "چی خنده‌داره؟"
 },
 {
  "line": 16,
  "start": 33.6,
  "end": 35.52439583333334,
  "who": "Principal",
  "text": "توجه! همه در کلاس بمونید!"
 },
 {
  "line": 17,
  "start": 35.58439583333334,
  "end": 36.945354166666675,
  "who": "Principal",
  "text": "درها رو قفل کنید!"
 },
 {
  "line": 18,
  "start": 37.00535416666668,
  "end": 38.640354166666675,
  "who": "Principal",
  "text": "هیچ‌کس بیرون نـ..."
 },
 {
  "line": 19,
  "start": 41.0,
  "end": 43.29,
  "who": "Mahsa",
  "text": "اون... آقای رضاییه؟"
 },
 {
  "line": 20,
  "start": 43.4,
  "end": 44.66,
  "who": "Kian",
  "text": "چشماش!"
 },
 {
  "line": 21,
  "start": 46.3,
  "end": 47.665,
  "who": "Kazemi",
  "text": "میزها رو بیارید!"
 },
 {
  "line": 22,
  "start": 48.6,
  "end": 50.23502083333334,
  "who": "Arian",
  "text": "هل بده! هل بده!"
 },
 {
  "line": 23,
  "start": 52.6,
  "end": 53.795,
  "who": "Kian",
  "text": "می‌خوام برم خونه..."
 },
 {
  "line": 24,
  "start": 55.2,
  "end": 56.335,
  "who": "Me",
  "text": "حق با مامان بود..."
 },
 {
  "line": 25,
  "start": 58.6,
  "end": 60.25366666666667,
  "who": "Heli",
  "text": "بچه‌ها! بیاید پشت‌بوم!"
 },
 {
  "line": 26,
  "start": 60.31366666666667,
  "end": 62.29766666666667,
  "who": "Arian",
  "text": "ارتش اومد! نجات پیدا کردیم!"
 },
 {
  "line": 27,
  "start": 62.357666666666674,
  "end": 63.43268750000001,
  "who": "Kazemi",
  "text": "همه دنبال من!"
 },
 {
  "line": 28,
  "start": 64.2,
  "end": 65.74000000000001,
  "who": "Kian",
  "text": "دستمو ول نکن!"
 },
 {
  "line": 29,
  "start": 66.0,
  "end": 67.845,
  "who": "Me",
  "text": "بدو! فقط بدو!"
 },
 {
  "line": 30,
  "start": 70.0,
  "end": 71.825,
  "who": "Soldier",
  "text": "زود باش! دستتو بده!"
 },
 {
  "line": 31,
  "start": 74.0,
  "end": 76.19002083333334,
  "who": "Me",
  "text": "ارتش... نابسامان شده..."
 }
]